{
  "name": "ipqs",
  "private": true,
  "type": "module",
  "description": "IP quality check: asks a dozen IP intelligence sources and DNS blocklists about an address and turns their answers into one score, with what it means for streaming, AI services, CAPTCHAs, sign-ups and mail",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs --check && node --test \"test/*.test.mjs\"",
    "dev": "wrangler dev --port 8792",
    "deploy": "wrangler deploy",
    "og": "node scripts/og.mjs",
    "probe": "node --env-file-if-exists=../1ms-shell/.env scripts/probe.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "esbuild": "0.25.10"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yt1988/ip-quality-test"
  },
  "homepage": "https://ipqs.1ms.dog"
}
